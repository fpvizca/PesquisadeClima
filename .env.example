# Copie este arquivo para .env e preencha os valores

# Chave secreta para sessões Flask (gere uma chave forte e única)
SECRET_KEY=_change_this_to_a_random_secret_key

# Modo debug (true/false) - NUNCA use true em produção
DEBUG=true

# URL base da API de autenticação externa
API_BASE=https://relats.vizca.com.br
