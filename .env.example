# Copie este arquivo para .env e preencha os valores
#   cp .env.example .env

# Chave secreta para sessoes Flask (gere uma forte e unica)
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque_esta_chave_por_uma_aleatoria_forte

# Modo debug - NUNCA use true em producao
DEBUG=false

# Porta e host do servidor
PORT=5005
HOST=127.0.0.1

# Duracao da sessao em minutos
SESSION_MINUTES=20

# API de autenticacao externa
API_BASE=https://relats.vizca.com.br

# Ollama (analise por IA)
OLLAMA_BASE=http://192.168.170.12:11434
OLLAMA_MODEL=ministral-3:8b

# Timeout de cada chamada ao Ollama, em segundos.
# O export Word faz ~90 chamadas, entao um timeout alto deixa a exportacao lenta.
OLLAMA_TIMEOUT=20

# Cache em memoria de analises ja geradas (evita regenerar o mesmo prompt).
OLLAMA_CACHE_MAX=300

# Circuit breaker: apos uma falha, as proximas chamadas falham na hora por
# este numero de segundos, em vez de esperar o timeout uma a uma.
OLLAMA_COOLDOWN=60

# Exportacao Word: numberos maximo de analises por IA geradas em um export.
# excedente e avisado no proprio documento. Use 0 em EXPORTAR_WORD_IA para desligar.
EXPORTAR_WORD_IA=1
EXPORTAR_WORD_IA_MAX=40

# Ano citado na mensagem de bloqueio.
# Se nao definido, usa o ano do ciclo ativo (se >= ano atual) ou o ano atual.
# ANO_PESQUISA=2026
